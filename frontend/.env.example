# Copy to `.env.local` and fill in. The local synthetic demo only requires the
# API URL. Every value in this file is browser-visible; never place secrets here.

# --- Epicenter API ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Clerk authentication ---
# Clerk wraps the frontend when this key is present.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Supabase browser-safe configuration ---
# Reserved for browser-safe capabilities such as Realtime. Operational data is
# currently routed through FastAPI, so these values are optional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
