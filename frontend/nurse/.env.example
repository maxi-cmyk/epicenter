# Copy to `.env.local` and fill in. Every value in this file is browser-visible;
# never place backend secrets here.

# --- Shared Epicenter API ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Clerk staff authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Supabase browser-safe configuration ---
# Operational writes still pass through FastAPI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
