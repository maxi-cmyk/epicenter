{
  "name": "epicenter-frontends",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "patient",
    "nurse",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev:patient",
    "dev:patient": "npm run dev --workspace @epicenter/patient",
    "dev:nurse": "npm run dev --workspace @epicenter/nurse",
    "patient": "npm run dev:patient",
    "nurse": "npm run dev:nurse",
    "build": "npm run build:patient && npm run build:nurse",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "build:patient": "npm run build --workspace @epicenter/patient",
    "build:nurse": "npm run build --workspace @epicenter/nurse",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test tests/*.test.mjs && node --experimental-strip-types --test tests/simulation-engine.test.ts",
    "test:auth-live": "playwright test --config playwright.auth.config.ts",
    "qa:auth": "node tests/auth-visual-qa.mjs",
    "qa:visual": "node tests/visual-qa.mjs"
  },
  "devDependencies": {
    "@clerk/backend": "^3.16.3",
    "@clerk/testing": "^2.2.22",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.0"
  }
}
