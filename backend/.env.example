# Copy to `.env` and fill in. The local synthetic demo works without provider
# credentials. Prefix for Epicenter-owned backend settings is `EPICENTER_`.

# --- Application / API ---
EPICENTER_APP_NAME=Epicenter API
EPICENTER_ENVIRONMENT=development
EPICENTER_API_PREFIX=/api/v1
EPICENTER_CLINIC_ID=clinic_harbourfront
# Synthetic patient scenario assigned after verified patient sign-up.
EPICENTER_PATIENT_DEMO_SOURCE_RECORD_KEY=registration:0107
# Comma-separated. Covers both the patient screen (port 3000) and the
# nurse/staff screen (port 3001). EPICENTER_FRONTEND_ORIGIN (singular) still
# works for a single-origin override.
EPICENTER_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
# Keep true for the synthetic local demo. Production must set this to false.
EPICENTER_DEMO_MODE=true
# `auto` uses Supabase when URL + secret are configured, otherwise the in-memory
# fixture. Set `demo` to force isolation or `supabase` to require persistence.
EPICENTER_PERSISTENCE_MODE=auto

# --- Supabase persistence boundary ---
EPICENTER_SUPABASE_URL=
# Safe to expose to a browser, although this application routes operational
# data through FastAPI rather than querying Supabase directly.
EPICENTER_SUPABASE_PUBLISHABLE_KEY=
# Backend only. Never expose this as `NEXT_PUBLIC_*` or commit a real value.
EPICENTER_SUPABASE_SECRET_KEY=

# --- Clerk authentication boundary ---
# Used only for server-side Clerk API operations when those are introduced.
CLERK_SECRET_KEY=
# Optional PEM public key from Clerk's API Keys page. When omitted, the Clerk
# Python SDK retrieves and caches the instance JWKS using the secret key.
CLERK_JWT_KEY=
